<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:state_pressed="true">

        <shape>

            <solid
                android:color="#10242C" />

            <stroke
                android:width="3dp"
                android:color="#00E5FF" />

            <corners
                android:radius="18dp" />

        </shape>

    </item>


    <item>

        <shape>

            <solid
                android:color="#101820" />

            <stroke
                android:width="2dp"
                android:color="#31515B" />

            <corners
                android:radius="18dp" />

        </shape>

    </item>

</selector>